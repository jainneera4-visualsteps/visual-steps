{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "server.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    { "path": "/api/cron/weekly-newsletter/0", "schedule": "0 0 * * *" },
    { "path": "/api/cron/weekly-newsletter/1", "schedule": "0 1 * * *" },
    { "path": "/api/cron/weekly-newsletter/2", "schedule": "0 2 * * *" },
    { "path": "/api/cron/weekly-newsletter/3", "schedule": "0 3 * * *" },
    { "path": "/api/cron/weekly-newsletter/4", "schedule": "0 4 * * *" },
    { "path": "/api/cron/weekly-newsletter/5", "schedule": "0 5 * * *" },
    { "path": "/api/cron/weekly-newsletter/6", "schedule": "0 6 * * *" },
    { "path": "/api/cron/weekly-newsletter/7", "schedule": "0 7 * * *" },
    { "path": "/api/cron/weekly-newsletter/8", "schedule": "0 8 * * *" },
    { "path": "/api/cron/weekly-newsletter/9", "schedule": "0 9 * * *" },
    { "path": "/api/cron/weekly-newsletter/10", "schedule": "0 10 * * *" },
    { "path": "/api/cron/weekly-newsletter/11", "schedule": "0 11 * * *" },
    { "path": "/api/cron/weekly-newsletter/12", "schedule": "0 12 * * *" },
    { "path": "/api/cron/weekly-newsletter/13", "schedule": "0 13 * * *" },
    { "path": "/api/cron/weekly-newsletter/14", "schedule": "0 14 * * *" },
    { "path": "/api/cron/weekly-newsletter/15", "schedule": "0 15 * * *" },
    { "path": "/api/cron/weekly-newsletter/16", "schedule": "0 16 * * *" },
    { "path": "/api/cron/weekly-newsletter/17", "schedule": "0 17 * * *" },
    { "path": "/api/cron/weekly-newsletter/18", "schedule": "0 18 * * *" },
    { "path": "/api/cron/weekly-newsletter/19", "schedule": "0 19 * * *" },
    { "path": "/api/cron/weekly-newsletter/20", "schedule": "0 20 * * *" },
    { "path": "/api/cron/weekly-newsletter/21", "schedule": "0 21 * * *" },
    { "path": "/api/cron/weekly-newsletter/22", "schedule": "0 22 * * *" },
    { "path": "/api/cron/weekly-newsletter/23", "schedule": "0 23 * * *" }
  ]
}
